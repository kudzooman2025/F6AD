rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Site owner: verified email match (bootstrap — works before any staff docs exist)
    function isOwner() {
      return signedIn()
        && request.auth.token.email in ['kudzooman@gmail.com', 'kudzooman@proton.me']
        && request.auth.token.email_verified == true;
    }
    // Staff: has a record in the staff collection (created by an admin)
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isAdmin() {
      return isOwner()
        || (isStaff()
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin');
    }
    function ownsPlayer(pid) {
      return signedIn()
        && exists(/databases/$(database)/documents/family_links/$(request.auth.uid + '_' + pid))
        && get(/databases/$(database)/documents/family_links/$(request.auth.uid + '_' + pid)).data.status == 'approved';
    }
    function canEditOutsideGame(g) {
      return isStaff() || isAdmin()
        || (signedIn() && g.owner_uid == request.auth.uid && ownsPlayer(g.player_id));
    }
    function validOutsideEvent(e) {
      let g = get(/databases/$(database)/documents/gt_ext_games/$(e.ext_game_id)).data;
      return e.owner_uid == g.owner_uid && e.player_id == g.player_id
        && canEditOutsideGame(g);
    }
    function canSubmitEval(doc, e) {
      return signedIn() && (
        (e.rater_type == 'peer'
          && doc == e.period + '_peer_' + e.rater_id + '_' + e.target_player_id
          && e.rater_id != e.target_player_id
          && exists(/databases/$(database)/documents/pd_player_links/$(request.auth.uid + '_' + e.rater_id))
          && get(/databases/$(database)/documents/pd_player_links/$(request.auth.uid + '_' + e.rater_id)).data.status == 'approved')
        || (e.rater_type == 'family' && e.rater_id == request.auth.uid
          && doc == e.period + '_family_' + request.auth.uid + '_' + e.target_player_id
          && ownsPlayer(e.target_player_id)));
    }

    // Staff directory: users can read their own record; admins manage all
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- Public family features (no account needed) ----
    match /votes_fall/{doc}     { allow read, write: if true; }
    match /votes_winter/{doc}   { allow read, write: if true; }
    match /votes_spring/{doc}   { allow read, write: if true; }
    match /votes_summer27/{doc} { allow read, write: if true; }
    match /conditioning/{doc}   { allow read, write: if true; }

    // ---- Team content: public read, admin write ----
    match /schedule/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{doc} { allow read: if true; allow write: if isAdmin(); }

    // ---- Coach-managed data: public read, staff write ----
    match /players/{doc}     { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /session_log/{doc} { allow read: if true; allow write: if isStaff() || isAdmin(); }

    // ---- GameTracker: public read (parents), staff write ----
    match /gt_rosters/{doc}      { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_players/{doc}      { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_games/{doc}        { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_availability/{doc} { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_events/{doc}       { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_subs/{doc} {
      allow read: if true;
      allow create, delete: if isStaff() || isAdmin();
      // staff edit anything; anyone may correct ONLY the position field (parent/player review)
      allow update: if isStaff() || isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['position']);
    }
    match /gt_tournaments/{doc}  { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_seasons/{doc}      { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /venues/{doc}          { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /gt_chat/{doc}         { allow read, create: if true; allow update, delete: if isStaff() || isAdmin(); }
    match /gt_rsvp/{doc}         { allow read, write: if true; }
    match /gt_parent_events/{doc} { allow read, write: if true; }
    match /gt_parent_claims/{doc} { allow read, write: if true; }
    match /site_flags/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /site_secrets/{doc}   { allow read, write: if isAdmin(); }
    match /feedback/{doc}       { allow create: if true; allow read, update, delete: if isStaff() || isAdmin(); }
    // ---- Outside games (a player guesting for another club, school, indoor) ----
    // Their own collections, never gt_games: nothing that reads team games can
    // see them by accident, so they can't reach team or season totals.
    // Events must belong to a game this account can manage.
    match /gt_ext_games/{doc} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid
        && (ownsPlayer(request.resource.data.player_id) || isStaff() || isAdmin());
      allow update: if canEditOutsideGame(resource.data)
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.player_id == resource.data.player_id;
      allow delete: if canEditOutsideGame(resource.data);
    }
    match /gt_ext_events/{doc} {
      allow read: if signedIn();
      allow create: if validOutsideEvent(request.resource.data);
      allow update: if validOutsideEvent(resource.data)
        && request.resource.data.ext_game_id == resource.data.ext_game_id
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.player_id == resource.data.player_id;
      allow delete: if validOutsideEvent(resource.data) || isStaff() || isAdmin();
    }

    // Guest-player applications: the public may submit, only staff may read or act.
    match /gt_guest_apps/{doc}  { allow create: if true; allow read, update, delete: if isStaff() || isAdmin(); }
    match /pd_config/{doc}      { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /pd_evals/{doc} {
      allow read: if isStaff() || isAdmin();
      allow create: if isStaff() || isAdmin() || canSubmitEval(doc, request.resource.data);
      allow update: if isStaff() || isAdmin()
        || (canSubmitEval(doc, resource.data) && canSubmitEval(doc, request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['period', 'rater_type', 'rater_id', 'target_player_id']));
      allow delete: if isStaff() || isAdmin();
    }
    match /pd_player_links/{doc} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isStaff() || isAdmin();
      allow delete: if isStaff() || isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    match /pd_cards/{doc} {
      allow read: if isStaff() || isAdmin()
        || (request.auth != null
            && exists(/databases/$(database)/documents/pd_player_links/$(request.auth.uid + '_' + resource.data.player_id))
            && get(/databases/$(database)/documents/pd_player_links/$(request.auth.uid + '_' + resource.data.player_id)).data.status == 'approved')
        || (request.auth != null
            && exists(/databases/$(database)/documents/family_links/$(request.auth.uid + '_' + resource.data.player_id))
            && get(/databases/$(database)/documents/family_links/$(request.auth.uid + '_' + resource.data.player_id)).data.status == 'approved');
      allow write: if isStaff() || isAdmin();
    }
    match /families/{uid}       { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid; }
    match /player_profiles/{pid} {
      allow read: if true;
      allow write: if isStaff() || isAdmin() ||
        (request.auth != null &&
         exists(/databases/$(database)/documents/family_links/$(request.auth.uid + '_' + pid)) &&
         get(/databases/$(database)/documents/family_links/$(request.auth.uid + '_' + pid)).data.status == 'approved');
    }
    match /family_links/{doc} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isStaff() || isAdmin();
      allow delete: if isStaff() || isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    match /cancellations/{doc}  { allow read: if true; allow write: if isStaff() || isAdmin(); }
    match /ann_comments/{doc}   { allow read, create: if true; allow update, delete: if isStaff() || isAdmin(); }
    // Discussions: anyone can read/post; anyone may change ONLY the vote count;
    // content edits and deletes are staff-only.
    match /discussions/{doc} {
      allow read: if true;
      allow create: if request.resource.data.votes is int && request.resource.data.votes == 0;
      allow update: if request.resource.data.votes is int
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) || isStaff() || isAdmin());
      allow delete: if isStaff() || isAdmin();
    }
    match /discussion_comments/{doc} {
      allow read: if true;
      allow create: if request.resource.data.votes is int && request.resource.data.votes == 0;
      allow update: if request.resource.data.votes is int
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) || isStaff() || isAdmin());
      allow delete: if isStaff() || isAdmin();
    }

    // ---- Legacy coach PIN collection: locked down, no longer used ----
    match /coaches/{doc} { allow read, write: if isAdmin(); }

    // Ephemeral server-time ping: lets the app measure device clock skew so the
    // live game clock is accurate. Holds no user data.
    match /_serverclock/{doc} { allow read, write: if true; }

    // Visitor log: anyone can record their own device visit; only admins can read it.
    match /site_visits/{doc} { allow read, delete: if isAdmin(); allow create, update: if true; }

    // Account directory: a signed-in user records their own entry; admins read all.
    match /user_directory/{uid} { allow read, delete: if isAdmin(); allow write: if signedIn() && request.auth.uid == uid; }
  }
}
